<Window x:Class="AutoTint.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="AutoTint"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Width="640" Height="400"
        MinWidth="280" MinHeight="120"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The tint. Opacity is set HERE, never on the Window: window-level opacity would
             dim the tab along with it, and the tab has to stay readable at 0% tint so the
             tint can be switched back on. -->
        <Border x:Name="TintSurface"
                Grid.Row="0"
                Background="Black"
                CornerRadius="{StaticResource TintCornerRadius}"
                Opacity="0.5" />

        <!-- The control tab, hanging below the tint. -->
        <Border x:Name="TabSurface"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Background="{StaticResource TabBrush}"
                CornerRadius="{StaticResource TabCornerRadius}"
                Padding="10,4,10,6">
            <StackPanel>

                <!-- Dot grip: reported to Windows as HTCAPTION, so the OS drags the window. -->
                <Border x:Name="GripSurface" Height="14" Background="Transparent">
                    <primitives:UniformGrid Rows="2" Columns="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedOnTabBrush}" Margin="2,1" />
                    </primitives:UniformGrid>
                </Border>

                <!-- Always visible: one-click on/off, and the settings toggle. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PowerButton"
                            Style="{StaticResource TabIconButton}"
                            Content="&#xE7E8;"
                            ToolTip="Turn the tint off and on (Alt+Shift+T)" />
                    <Button x:Name="ExpandButton"
                            Style="{StaticResource TabIconButton}"
                            Content="&#xE740;"
                            ToolTip="Show settings" />
                </StackPanel>

                <!-- Revealed by the settings button. -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,4,0,0">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Slider x:Name="OpacitySlider"
                                Style="{StaticResource TintSlider}"
                                Width="170"
                                Minimum="0" Maximum="90"
                                Value="50"
                                ToolTip="Tint strength" />
                        <TextBlock x:Name="OpacityReadout"
                                   Text="50%"
                                   Foreground="{StaticResource OnTabBrush}"
                                   FontSize="11"
                                   Width="58"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton x:Name="SwatchBlack"
                                     Style="{StaticResource SwatchButton}"
                                     GroupName="TintColour"
                                     Background="#000000"
                                     IsChecked="True"
                                     ToolTip="Neutral black" />
                        <RadioButton x:Name="SwatchWarm"
                                     Style="{StaticResource SwatchButton}"
                                     GroupName="TintColour"
                                     Background="#3B2400"
                                     ToolTip="Warm amber" />
                        <RadioButton x:Name="SwatchGrey"
                                     Style="{StaticResource SwatchButton}"
                                     GroupName="TintColour"
                                     Background="#5A6068"
                                     ToolTip="Soft grey" />

                        <Border Width="1" Height="16" Margin="8,0"
                                Background="{StaticResource TabSunkenBrush}" />

                        <Button x:Name="AutoButton"
                                Style="{StaticResource TabIconButton}"
                                Content="&#xE793;"
                                ToolTip="Auto-adjust off" />
                        <Button x:Name="SnapButton"
                                Style="{StaticResource TabIconButton}"
                                Content="&#xE9A6;"
                                ToolTip="Auto-snap off" />
                        <Button x:Name="CaptureButton"
                                Style="{StaticResource TabIconButton}"
                                Content="&#xED1A;"
                                ToolTip="Hide the tint from screen sharing" />
                        <Button x:Name="MenuButton"
                                Style="{StaticResource TabIconButton}"
                                Content="&#xE713;"
                                ToolTip="More" />
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
